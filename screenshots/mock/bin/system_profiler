#!/bin/sh

# system_profiler for battery.sh: a healthy battery

case "$1" in
  SPPowerDataType)
    echo '{"SPPowerDataType":[{"sppower_battery_health_info":{"sppower_battery_health":"Good","sppower_battery_health_maximum_capacity":"98%","sppower_battery_cycle_count":112}}]}'
    ;;
  *) exec /usr/sbin/system_profiler "$@" ;;
esac
