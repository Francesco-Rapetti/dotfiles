#!/bin/sh

# Claude Code for claude.sh: an account on the Max plan, 42% of the 5-hour session used and 31% of
# the week, which reset in 2 h 57 min and in 3 days 5 h from MOCK_NOW. The name of the account is in
# the .claude.json of the made-up HOME

reset() {
  /bin/date -u -r $((MOCK_NOW + $1)) +%Y-%m-%dT%H:%M:%SZ
}

case "$1:$2" in
  auth:status) echo '{"loggedIn":true,"email":"mario.rossi@example.com","orgName":"","subscriptionType":"max"}' ;;
  -p:*)
    cat > /dev/null
    printf '{"type":"control_response","response":{"request_id":"usage","response":{"rate_limits":{"five_hour":{"utilization":42,"resets_at":"%s"},"seven_day":{"utilization":31,"resets_at":"%s"}}}}}\n' \
      "$(reset $((2 * 3600 + 57 * 60)))" "$(reset $((3 * 86400 + 5 * 3600)))"
    ;;
esac
