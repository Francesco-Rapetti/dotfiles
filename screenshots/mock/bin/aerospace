#!/bin/sh

# AeroSpace for aerospace.sh and notification.sh: made-up windows in workspaces 1, 2, 3, 8 and 9,
# the first one of workspace 1 focused and in fullscreen, the main binding mode, and a running
# AeroSpace older than the installed one, so that the popup of the notifications has "Riavvia
# AeroSpace". It never calls the real one, which would move the windows

case "$1" in
  list-windows)
    case " $* " in
      *" --focused "*) echo 101 ;;
      *)
        cat <<'WINDOWS'
1|101|true|com.apple.Safari|Safari
1|102|false|com.apple.Terminal|Terminal
1|103|false|com.apple.Terminal|Terminal
2|201|false|com.apple.Music|Music
3|301|false|com.apple.Notes|Notes
3|302|false|com.apple.iCal|Calendar
8|801|false|com.apple.MobileSMS|Messages
9|901|false|com.apple.mail|Mail
WINDOWS
        ;;
    esac
    ;;
  list-workspaces) echo 1 ;;
  list-modes) echo main ;;
  --version)
    echo "aerospace CLI client version: 0.21.3-Beta 0000000000000000000000000000000000000000"
    echo "AeroSpace.app server version: 0.20.2-Beta 0000000000000000000000000000000000000000"
    ;;
esac
