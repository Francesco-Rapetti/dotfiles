#!/usr/bin/env bash

# SketchyBar config: AeroSpace workspaces + a few basic items
# Docs: https://felixkratz.github.io/SketchyBar/config/bar

PLUGIN_DIR="$CONFIG_DIR/plugins"

# Catppuccin Mocha with mauve as PRIMARY, shared with the plugins
source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
# Transparent: each component floats on a background of its own (pill below). 40pt: 6 above the
# 28 of the components and 6 below; aerospace.toml keeps the windows 8 below them.
# With the padding of the first and last item, the components line up with the windows, 8 from
# the edges (outer.left and outer.right in aerospace.toml)
sketchybar --bar position=top height=40 color=$TRANSPARENT shadow=off \
                 padding_left=8 padding_right=4

##### Defaults #####
# Text only: the items that need an icon turn it on and use SF Symbols from SF Pro
default=(
  padding_left=4
  padding_right=4
  icon.drawing=off
  label.font="Helvetica Neue:Bold:13.0"
  label.color=$TEXT
  label.padding_left=6
  label.padding_right=6
)
sketchybar --default "${default[@]}"

# Added to the items that show an SF Symbol before their label.
# SketchyBar sizes the icon by its ink but draws it from the glyph origin, ~2pt further right:
# icon.padding_right keeps the edge from being clipped when the label is hidden
with_icon=(
  icon.drawing=on
  icon.font="SF Pro:Semibold:14.0"
  icon.padding_left=6
  icon.padding_right=2
  label.padding_left=2
)

# The background of a component: the item's own when it is a single item, a bracket's when it is
# made of more (the workspaces, CPU/GPU/memory, audio). SketchyBar draws the padding of an item
# outside its own background but inside a bracket, which covers the padding of its first and last
# member: 4, plus 6 of icon or label padding, from its edge to the content. So the single items have
# 10 of icon or label padding (text_pill, icon_pill) and, on the side of a bracket, padding 8: the
# gap between two single items, 4 + 4
pill=(
  background.drawing=on
  background.color=$BASE
  background.corner_radius=10
  background.height=28
  background.border_width=2
  background.border_color=$SURFACE
)
text_pill=("${pill[@]}" label.padding_left=10 label.padding_right=10)
icon_pill=("${with_icon[@]}" "${pill[@]}" icon.padding_left=10 label.padding_right=10)

# The popups open under the bar, 6pt under the components, at the edge of the pill on the side
# they are aligned to. BASE at 90% over the blur
popup=(
  popup.blur_radius=20
  popup.background.color=0xe6${BASE#0xff}
  popup.background.corner_radius=10
  popup.background.border_width=2
  popup.background.border_color=$SURFACE
)

##### Apple Menu #####
# The  menu of the menu bar, which SketchyBar covers: a click on the apple opens its commands.
# macOS has no command line tool for Recent Items and Lock Screen, so apple.sh asks a Swift helper
# (rebuilt when its source changes)
APPLE_HELPER="$CONFIG_DIR/helpers/apple_menu"
if [ ! -x "$APPLE_HELPER" ] || [ "$APPLE_HELPER.swift" -nt "$APPLE_HELPER" ]; then
  swiftc -O "$APPLE_HELPER.swift" -o "$APPLE_HELPER"
fi
# The only component without a pill: the logo stands on the desktop, as in the menu bar. No
# padding_left, so that the popup, aligned to its padding, starts at the edge of the windows, and
# the ink, 2pt after the icon padding, is that far from it too. 10 from the ink to the workspaces
apple=(
  "${with_icon[@]}"
  icon=􀣺  # apple.logo
  icon.font="SF Pro:Semibold:16.0"
  icon.color=$TEXT
  icon.padding_left=0
  icon.padding_right=4
  label.drawing=off
  padding_left=0
  padding_right=8
  script="$PLUGIN_DIR/apple.sh"
  "${popup[@]}"
  popup.align=left
  # No minimum: apple.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add item apple left \
           --set apple "${apple[@]}" \
           --subscribe apple mouse.clicked mouse.exited.global

##### AeroSpace Workspaces #####
# See: https://nikitabobko.github.io/AeroSpace/goodies#show-aerospace-workspaces-in-sketchybar
# Fixed 1-9 list (matches the alt-<n> bindings) instead of `aerospace list-workspaces --all`,
# which only returns the workspaces alive when the bar loads.
# aerospace.sh runs for the hidden item aerospace: it shows, hides and highlights the numbers and
# adds the icons of the windows after them, the focused window on a darker tile (a click on one
# focuses that window) and the one in fullscreen with the fullscreen symbol after its icon (alt-f in
# aerospace.toml notifies it). The icons follow the order of the windows on screen, which AeroSpace
# doesn't say: the helper window_order (rebuilt when its source changes) reads it from macOS.
# space_windows_change: a window opened or closed. aerospace_windows_change: AeroSpace moved the
# focus or a window, or put one in fullscreen (on-focus-changed and the alt-shift-<n>,
# alt-shift-a/s/w/d and alt-f bindings in aerospace.toml)
ORDER_HELPER="$CONFIG_DIR/helpers/window_order"
if [ ! -x "$ORDER_HELPER" ] || [ "$ORDER_HELPER.swift" -nt "$ORDER_HELPER" ]; then
  swiftc -O "$ORDER_HELPER.swift" -o "$ORDER_HELPER"
fi
sketchybar --add event aerospace_workspace_change \
           --add event aerospace_windows_change

# The workspaces share a pill, the bracket spaces between two empty items, spaces.start and
# spaces.end: aerospace.sh adds and removes the icons between them, and an item can't be in two
# brackets, its own space.<n>.group (the highlight of the focused one, on top since it comes later)
# and this one. Their padding is the room around the highlight, 3pt as above and below it
sketchybar --add item spaces.start left \
           --set spaces.start label.drawing=off padding_left=0 padding_right=3

for sid in 1 2 3 4 5 6 7 8 9; do
  workspace=(
    drawing=off
    padding_right=0
    label="$sid"
    label.padding_left=6
    label.padding_right=10
    click_script="aerospace workspace $sid"
  )
  sketchybar --add item space.$sid left \
             --set space.$sid "${workspace[@]}"
done

sketchybar --add item spaces.end left \
           --set spaces.end label.drawing=off padding_left=3 padding_right=0 \
           --add bracket spaces spaces.start spaces.end \
           --set spaces "${pill[@]}"

sketchybar --add item aerospace left \
           --set aerospace drawing=off script="$PLUGIN_DIR/aerospace.sh" \
           --subscribe aerospace aerospace_workspace_change aerospace_windows_change \
                                 front_app_switched space_windows_change

# The binding mode of AeroSpace, in a peach pill after the workspaces while it isn't main, e.g.
# service (alt-shift-semicolon): a click goes back to main. aerospace.sh watch triggers
# aerospace_mode_change whenever the mode changes. padding_left=8: the workspaces bracket is on
# its left, and front_app keeps its own 8 on its right
aerospace_mode=(
  "${icon_pill[@]}"
  drawing=off
  padding_left=8
  padding_right=0
  icon=􀤋  # wrench.and.screwdriver.fill
  icon.color=$CRUST
  label.color=$CRUST
  background.color=$PEACH
  background.border_color=$PEACH
  script="$PLUGIN_DIR/aerospace.sh"
  click_script="aerospace mode main"
)
sketchybar --add event aerospace_mode_change \
           --add item aerospace_mode left \
           --set aerospace_mode "${aerospace_mode[@]}" \
           --subscribe aerospace_mode aerospace_mode_change
pkill -f "$PLUGIN_DIR/aerospace.sh watch"
"$PLUGIN_DIR/aerospace.sh" watch > /dev/null 2>&1 &

##### Left Items #####
sketchybar --add item front_app left \
           --set front_app "${text_pill[@]}" padding_left=8 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Right Items #####
# Notifications, two badges at the right end, each hidden when it has nothing to count: a green one
# with what the apps of notification_apps.conf have to read, the badges on their icons in the Dock
# (e.g. the unread messages of Slack), and a red one with the updates for the packages in
# ../Brewfile. A click on either lists both: a click on an app opens it, a click on a package
# upgrades it; until AeroSpace restarts on a new version the list also has a row that restarts it.
# The popup is the one of the notification item, empty, on the right of the badges: so it opens at
# the edge of the last one drawn, which with its padding_right of 4 ends 8 from the edge of the
# screen as the other components. notification.sh runs brew update hourly, on wake and on reload;
# brew_update refreshes the list without it, e.g. once an upgrade is done. macOS doesn't tell when
# a badge changes: notification.sh watch reads them every 2 seconds and triggers
# notification_change when they change
notification=(
  drawing=off
  label.drawing=off
  padding_left=0
  update_freq=3600
  script="$PLUGIN_DIR/notification.sh"
  "${popup[@]}"
  popup.align=right
  # No minimum: notification.sh gives each row of the popup its own height
  popup.height=0
)
# padding_left=8: the clock bracket is on their left; notification.sh moves the red one next to the
# green one when both are drawn
badge=(
  drawing=off
  padding_left=8
  padding_right=0
  click_script="sketchybar --set notification popup.drawing=toggle"
  label.font="Helvetica Neue:Bold:11.0"
  label.color=$CRUST
  # notification.sh centers the number with label.width and label.padding_left: label.align=center
  # measures the digits by their ink but draws them from their origin, which moves each one by a
  # different amount. y_offset lifts it by the room the line keeps for descenders, which digits
  # don't have
  label.align=left
  label.padding_right=0
  label.y_offset=1
  background.corner_radius=9
  background.height=18
)
sketchybar --add event brew_update \
           --add event notification_change \
           --add item notification right \
           --set notification "${notification[@]}" \
           --subscribe notification brew_update notification_change system_woke mouse.exited.global \
           --add item notification_brew right \
           --set notification_brew "${badge[@]}" background.color=$RED \
           --add item notification_apps right \
           --set notification_apps "${badge[@]}" background.color=$GREEN
pkill -f "$PLUGIN_DIR/notification.sh watch"
"$PLUGIN_DIR/notification.sh" watch > /dev/null 2>&1 &

# The date and the hour, two items in a pill: clock_date isn't on the display with the notch (see
# notch.sh below), so the popup is the bracket's, which is on every display and keeps it at the edge
# of the pill. A click on either opens the calendar of the month, an image that clock.sh has the
# helper calendar_month draw each time; a click on it opens the Calendar app
MONTH_HELPER="$CONFIG_DIR/helpers/calendar_month"
if [ ! -x "$MONTH_HELPER" ] || [ "$MONTH_HELPER.swift" -nt "$MONTH_HELPER" ]; then
  swiftc -O "$MONTH_HELPER.swift" -o "$MONTH_HELPER"
fi
# The hour starts at the edge of the pill when it is alone, so it is the date that leaves two
# spaces before it (7), with a negative padding_right: it cancels most of the padding of the hour
# (padding_left + label.padding_left)
clock_date=(
  label.padding_right=0
  padding_right=-3
  script="$PLUGIN_DIR/clock.sh"
)
clock=(
  "${pill[@]}"
  "${popup[@]}"
  popup.align=right
)
month=(
  label.drawing=off
  background.drawing=on
  click_script="open -a Calendar; sketchybar --set clock popup.drawing=off"
)
sketchybar --add item clock_time right \
           --set clock_time update_freq=10 script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock_time mouse.clicked mouse.exited.global \
           --add item clock_date right \
           --set clock_date "${clock_date[@]}" \
           --subscribe clock_date mouse.clicked \
           --add bracket clock clock_date clock_time \
           --set clock "${clock[@]}" \
           --add item clock.month popup.clock \
           --set clock.month "${month[@]}"

# Next event of the day from the macOS calendars, then today's all-day events, else hidden.
# macOS grants calendar access per app, so the helper is built into an app of its own and
# started with `open`: it triggers calendar_change whenever the event to show or the events of the
# day change. It is started without the shell's PATH, hence the path to sketchybar.
# Two items in a pill: calendar_time, the icon and the time of the event, in a color that tells how
# close it is, and calendar_title, the rest, which isn't on the display with the notch (see notch.sh
# below). So the popup is the bracket's, which is on every display and keeps it at the edge of the
# pill. Two brackets side by side would touch: calendar.gap, which calendar.sh shows with the
# event, keeps the clock one 8 away. A click on either lists the events of the day, and a click on
# one joins its Google Meet call or shows it in Calendar. The Meet logo is MeetingBar's, which
# helpers/meet_icon.js draws into helpers/meet_icon.png (a camera without the app)
CALENDAR_SOURCE="$CONFIG_DIR/helpers/calendar_events"
CALENDAR_APP="$CALENDAR_SOURCE.app"
CALENDAR_HELPER="$CALENDAR_APP/Contents/MacOS/calendar_events"
if [ ! -x "$CALENDAR_HELPER" ] || [ "$CALENDAR_SOURCE.swift" -nt "$CALENDAR_HELPER" ] \
   || [ "$CALENDAR_SOURCE.plist" -nt "$CALENDAR_HELPER" ]; then
  mkdir -p "$CALENDAR_APP/Contents/MacOS"
  cp "$CALENDAR_SOURCE.plist" "$CALENDAR_APP/Contents/Info.plist"
  swiftc -O "$CALENDAR_SOURCE.swift" -o "$CALENDAR_HELPER"
  codesign --force --sign - "$CALENDAR_APP"
fi
MEET_ICON="$CONFIG_DIR/helpers/meet_icon.png"
if [ ! -f "$MEET_ICON" ] || [ "$CONFIG_DIR/helpers/meet_icon.js" -nt "$MEET_ICON" ] \
   || [ /Applications/MeetingBar.app/Contents/Resources/Assets.car -nt "$MEET_ICON" ]; then
  osascript -l JavaScript "$CONFIG_DIR/helpers/meet_icon.js" "$MEET_ICON" A6E3A1
fi
# calendar.sh moves calendar_title next to the time with a negative padding_left
calendar_title=(
  drawing=off
  label.padding_left=0
  script="$PLUGIN_DIR/calendar.sh"
)
calendar=(
  "${pill[@]}"
  "${popup[@]}"
  popup.align=right
  # No minimum: calendar.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add event calendar_change \
           --add item calendar.gap right \
           --set calendar.gap drawing=off label.drawing=off padding_left=0 padding_right=8 \
           --add item calendar_title right \
           --set calendar_title "${calendar_title[@]}" \
           --subscribe calendar_title mouse.clicked \
           --add item calendar_time right \
           --set calendar_time "${with_icon[@]}" drawing=off script="$PLUGIN_DIR/calendar.sh" \
           --subscribe calendar_time calendar_change mouse.clicked mouse.exited.global \
           --add bracket calendar calendar_time calendar_title \
           --set calendar "${calendar[@]}"
pkill -x calendar_events
open -g -n "$CALENDAR_APP" --args "$(command -v sketchybar)"

# The charge, with an icon for the state: the level on battery, the bolt while charging, the plug
# when plugged in but not charging, green while the Charge Limit of macOS (26.4+) looks after the
# battery. A click opens the state in words, the limit, where a click sets another, Completa carica
# ora, the health of the battery and the Battery settings. macOS has no command line tool for the
# limit, so a Swift helper (rebuilt when its source changes) reads and sets it through the private
# framework of System Settings and, in watch mode, triggers battery_change whenever the battery or
# the limit changes. SF Symbols has the plug, but the font has no name for it:
# helpers/battery_icons.js draws it by name into helpers/battery_icons, in each color of battery.sh
BATTERY_HELPER="$CONFIG_DIR/helpers/battery_charge"
if [ ! -x "$BATTERY_HELPER" ] || [ "$BATTERY_HELPER.swift" -nt "$BATTERY_HELPER" ]; then
  swiftc -O "$BATTERY_HELPER.swift" -o "$BATTERY_HELPER"
fi
BATTERY_ICONS="$CONFIG_DIR/helpers/battery_icons"
if [ "$CONFIG_DIR/helpers/battery_icons.js" -nt "$BATTERY_ICONS/plug_text.png" ]; then
  # TEXT, the Catppuccin green and yellow of battery.sh
  osascript -l JavaScript "$CONFIG_DIR/helpers/battery_icons.js" "$BATTERY_ICONS" \
            text=CDD6F4 green=A6E3A1 yellow=F9E2AF
fi
# 8 on both sides: the connection bracket is on its left, the calendar one on its right
battery=(
  "${icon_pill[@]}"
  padding_left=8
  padding_right=8
  script="$PLUGIN_DIR/battery.sh"
  "${popup[@]}"
  popup.align=right
  # No minimum: battery.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add event battery_change \
           --add item battery right \
           --set battery "${battery[@]}" \
           --subscribe battery battery_change power_source_change system_woke \
                               mouse.clicked mouse.exited.global
pkill -x battery_charge
"$BATTERY_HELPER" watch > /dev/null 2>&1 &

# The connection: the Wi-Fi name with its band (2,4, 5 or 6 GHz) after it, Ethernet, or why there
# is none, and before it, in the same pill, the shield and the name of the VPN while one is on, as
# macOS puts the VPN before the Wi-Fi. The names are items of their own, network_name and
# network_vpn_name, which aren't on the display with the notch (see notch.sh below): there the icons
# stay, with the band. The popup is the bracket's, which keeps it at the edge of the pill whichever
# item ends it. A click on any of them opens the IP address of the Mac, the public one, the router and the VPN, then
# the rows that turn Ethernet and the Wi-Fi off or on and the Wi-Fi networks around the Mac, where
# a click joins one.
# macOS gives the names of the networks only to an app that may use Location Services, which also
# joins them: as for the calendar, the helper is built into an app of its own, and started with
# `open`. It keeps running, since the permission comes a few seconds after the app asks for it, and
# triggers wifi_networks_change whenever the networks change; the same helper outside the app asks
# it to look for networks or to join one (helpers/wifi_networks.swift). It is started without the
# shell's PATH, hence the path to sketchybar. The icons of the networks are the wifi SF Symbol with
# one, two or three bars, which helpers/network_icons.js draws into helpers/network_icons.
# wifi_change fires whenever the primary connection changes (Wi-Fi or Ethernet); update_freq
# catches the rest, e.g. a VPN turned on or off
WIFI_HELPER="$CONFIG_DIR/helpers/wifi_networks"
WIFI_APP="$WIFI_HELPER.app"
if [ ! -x "$WIFI_HELPER" ] || [ "$WIFI_HELPER.swift" -nt "$WIFI_HELPER" ] || [ "$WIFI_HELPER.plist" -nt "$WIFI_HELPER" ]; then
  mkdir -p "$WIFI_APP/Contents/MacOS"
  cp "$WIFI_HELPER.plist" "$WIFI_APP/Contents/Info.plist"
  swiftc -O "$WIFI_HELPER.swift" -o "$WIFI_HELPER"
  cp "$WIFI_HELPER" "$WIFI_APP/Contents/MacOS/wifi_networks"
  codesign --force --sign - "$WIFI_APP"
fi
NETWORK_ICONS="$CONFIG_DIR/helpers/network_icons"
if [ "$NETWORK_ICONS.js" -nt "$NETWORK_ICONS/wifi_3.png" ]; then
  osascript -l JavaScript "$NETWORK_ICONS.js" "$NETWORK_ICONS" ${TEXT#0xff}
fi
# Without its name, the icon ends as far from what follows as the pill starts before it, and the
# name moves back next to it, as for the audio devices
network=(
  "${with_icon[@]}"
  label.drawing=off
  padding_right=12
  update_freq=30
  script="$PLUGIN_DIR/network.sh"
)
network_name=(
  padding_left=-10
  label.padding_left=0
  script="$PLUGIN_DIR/network.sh"
)
# The band follows the name, or the icon, like a detail, as the battery of the audio devices:
# smaller and dimmer, and the negative padding cancels most of the space before it
network_band=(
  drawing=off
  padding_left=-10
  label.font="Helvetica Neue:Bold:11.0"
  label.color=$SUBTEXT
  script="$PLUGIN_DIR/network.sh"
)
connection=(
  "${pill[@]}"
  "${popup[@]}"
  # On the right like the other items on the right of the bar, so that it doesn't leave the screen
  popup.align=right
  # No minimum: network.sh gives each row of the popup its own height
  popup.height=0
)
# Without a label after it, the shield is as far from the next icon as a text is in a pill
# (label.padding_right + padding_right); the name of the VPN moves back next to it, 2 after it as
# the label of an icon (label.padding_left), with a negative padding_left
vpn=(
  "${with_icon[@]}"
  drawing=off
  icon=􀞚  # lock.shield.fill
  icon.color=$GREEN
  label.drawing=off
  padding_right=10
  script="$PLUGIN_DIR/network.sh"
)
vpn_name=(
  drawing=off
  padding_left=-8
  label.padding_left=0
  script="$PLUGIN_DIR/network.sh"
)
# Two brackets side by side would touch: connection.gap keeps the audio one 8 away, as the other
# components
sketchybar --add event wifi_networks_change \
           --add item network_band right \
           --set network_band "${network_band[@]}" \
           --subscribe network_band mouse.clicked \
           --add item network_name right \
           --set network_name "${network_name[@]}" \
           --subscribe network_name mouse.clicked \
           --add item network right \
           --set network "${network[@]}" \
           --subscribe network wifi_change wifi_networks_change system_woke \
                               mouse.clicked mouse.exited.global \
           --add item network_vpn_name right \
           --set network_vpn_name "${vpn_name[@]}" \
           --subscribe network_vpn_name mouse.clicked \
           --add item network_vpn right \
           --set network_vpn "${vpn[@]}" \
           --subscribe network_vpn mouse.clicked \
           --add bracket connection network_vpn network_vpn_name network network_name network_band \
           --set connection "${connection[@]}" \
           --add item connection.gap right \
           --set connection.gap label.drawing=off padding_left=0 padding_right=8
pkill -x wifi_networks
open -g -n "$WIFI_APP" --args watch "$(command -v sketchybar)"

# Default audio output and input. CoreAudio has no command line tool, so a Swift helper
# (rebuilt when its source changes) reads, lists and sets the devices and their volume and, in
# watch mode, triggers audio_device_change whenever the default output or input changes or a
# device comes or goes, and audio_volume_change whenever the volume of one of them changes
AUDIO_HELPER="$CONFIG_DIR/helpers/audio_devices"
if [ ! -x "$AUDIO_HELPER" ] || [ "$AUDIO_HELPER.swift" -nt "$AUDIO_HELPER" ]; then
  swiftc -O "$AUDIO_HELPER.swift" -o "$AUDIO_HELPER"
fi
# SF Symbols has no Galaxy Buds: helpers/galaxy_buds_icon.js makes their icon out of a photo,
# helpers/galaxy_buds_photo.png, which isn't in the repo (it's Samsung's). Without it audio.sh
# shows them as headphones
GALAXY_BUDS_PHOTO="$CONFIG_DIR/helpers/galaxy_buds_photo.png"
GALAXY_BUDS_ICON="$CONFIG_DIR/helpers/galaxy_buds_icon.png"
if [ -f "$GALAXY_BUDS_PHOTO" ] && { [ "$GALAXY_BUDS_PHOTO" -nt "$GALAXY_BUDS_ICON" ] \
   || [ "$CONFIG_DIR/helpers/galaxy_buds_icon.js" -nt "$GALAXY_BUDS_ICON" ]; }; then
  osascript -l JavaScript "$CONFIG_DIR/helpers/galaxy_buds_icon.js" "$GALAXY_BUDS_PHOTO" "$GALAXY_BUDS_ICON"
fi
# Nor the Mac, a display or audio glasses with a speaker, a microphone or both, since their own
# symbols are the same for both: helpers/audio_icons.js draws all of them into helpers/audio_icons,
# in the white of the icons
AUDIO_ICONS="$CONFIG_DIR/helpers/audio_icons"
if [ "$CONFIG_DIR/helpers/audio_icons.js" -nt "$AUDIO_ICONS/laptop_speaker.png" ]; then
  osascript -l JavaScript "$CONFIG_DIR/helpers/audio_icons.js" "$AUDIO_ICONS" FFFFFF
fi
# The popup connects and disconnects the Bluetooth devices with an app of its own, as for the
# calendar: macOS grants Bluetooth access per app, and asks the first time
BLUETOOTH_SOURCE="$CONFIG_DIR/helpers/bluetooth_devices"
BLUETOOTH_APP="$BLUETOOTH_SOURCE.app"
BLUETOOTH_HELPER="$BLUETOOTH_APP/Contents/MacOS/bluetooth_devices"
if [ ! -x "$BLUETOOTH_HELPER" ] || [ "$BLUETOOTH_SOURCE.swift" -nt "$BLUETOOTH_HELPER" ] \
   || [ "$BLUETOOTH_SOURCE.plist" -nt "$BLUETOOTH_HELPER" ]; then
  mkdir -p "$BLUETOOTH_APP/Contents/MacOS"
  cp "$BLUETOOTH_SOURCE.plist" "$BLUETOOTH_APP/Contents/Info.plist"
  swiftc -O "$BLUETOOTH_SOURCE.swift" -o "$BLUETOOTH_HELPER"
  codesign --force --sign - "$BLUETOOTH_APP"
fi
sketchybar --add event audio_device_change \
           --add event audio_volume_change
pkill -x audio_devices
"$AUDIO_HELPER" watch > /dev/null 2>&1 &

# audio.sh updates all four items, since the input hides when it is the same device as the
# output, or the Mac's microphone with its speakers; update_freq keeps the battery of Bluetooth
# devices up to date.
# The names are items of their own, audio_output_name and audio_input_name, which aren't on the
# display with the notch (see notch.sh below): there the icons stay, with the battery. Without a
# label after it, an icon ends as far from what follows as the pill starts before it (padding_left +
# icon.padding_left + 2 of the glyph); the name moves back next to it, 2 after it as the label of an
# icon, with a negative padding_left
audio_device=(
  "${with_icon[@]}"
  label.drawing=off
  padding_right=12
)
audio_name=(
  drawing=off
  padding_left=-10
  label.padding_left=0
  script="$PLUGIN_DIR/audio.sh"
)
# The battery follows the name, or the icon, like a detail of the device: smaller and dimmer, and
# the negative padding cancels most of the space before it (label.padding_right + padding_right).
# audio.sh sets the icon color, red when the battery is low
audio_battery=(
  "${with_icon[@]}"
  drawing=off
  padding_left=-10
  icon.font="SF Pro:Semibold:12.0"
  label.font="Helvetica Neue:Bold:11.0"
  label.color=$SUBTEXT
)
# A click on any of them opens the popup of audio_output, under the output and the input: the
# volume of each, with a slider, and their devices with the battery of the Bluetooth ones, where a
# click makes one the default; then the paired Bluetooth audio devices, which a click connects or
# disconnects
audio_output=(
  "${audio_device[@]}"
  update_freq=120
  script="$PLUGIN_DIR/audio.sh"
  "${popup[@]}"
  popup.align=left
  # No minimum: audio.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add item audio_input_battery right \
           --set audio_input_battery "${audio_battery[@]}" script="$PLUGIN_DIR/audio.sh" \
           --subscribe audio_input_battery mouse.clicked \
           --add item audio_input_name right \
           --set audio_input_name "${audio_name[@]}" \
           --subscribe audio_input_name mouse.clicked \
           --add item audio_input right \
           --set audio_input "${audio_device[@]}" script="$PLUGIN_DIR/audio.sh" \
           --subscribe audio_input mouse.clicked \
           --add item audio_output_battery right \
           --set audio_output_battery "${audio_battery[@]}" script="$PLUGIN_DIR/audio.sh" \
           --subscribe audio_output_battery mouse.clicked \
           --add item audio_output_name right \
           --set audio_output_name "${audio_name[@]}" \
           --subscribe audio_output_name mouse.clicked \
           --add item audio_output right \
           --set audio_output "${audio_output[@]}" \
           --subscribe audio_output audio_device_change audio_volume_change system_woke \
                                    mouse.clicked mouse.exited.global \
           --add bracket audio audio_output audio_output_name audio_output_battery \
                               audio_input audio_input_name audio_input_battery \
           --set audio "${pill[@]}"

# Claude plan usage: how much of the 5-hour session and of the weekly limit is used, in yellow
# from 75% and in red from 90%. A click opens the account, a bar and the time to the reset for
# each limit and the row that logs out, or the one that logs in. claude.sh asks Claude Code every
# 5 minutes, on wake and when the popup opens; claude_update refreshes it, e.g. after a login.
# The icon is the spark of the Claude app's menu bar icon, which helpers/claude_icon.js tints
# orange since SketchyBar can't color images; without the app it is the ✻ of Claude Code
CLAUDE_TRAY_ICON=/Applications/Claude.app/Contents/Resources/TrayIconTemplate-Dark@3x.png
CLAUDE_ICON="$CONFIG_DIR/helpers/claude_icon.png"
if [ -f "$CLAUDE_TRAY_ICON" ] && { [ "$CLAUDE_TRAY_ICON" -nt "$CLAUDE_ICON" ] \
   || [ "$CONFIG_DIR/helpers/claude_icon.js" -nt "$CLAUDE_ICON" ]; }; then
  osascript -l JavaScript "$CONFIG_DIR/helpers/claude_icon.js" "$CLAUDE_TRAY_ICON" "$CLAUDE_ICON" D97757
fi
if [ -f "$CLAUDE_ICON" ]; then
  # 72 px at 0.3: as tall as the SF Symbols of the other items. An image ignores the padding of the
  # icon and starts at its left edge: image.padding_left leaves the room before the symbols
  # (icon.padding_left plus their origin), in an icon as wide as that and the image
  claude_icon=(icon="" icon.width=34 icon.background.drawing=on icon.background.image="$CLAUDE_ICON"
               icon.background.image.scale=0.3 icon.background.image.padding_left=12)
else
  claude_icon=(icon="✻" icon.color=0xffd97757)
fi
# Between the audio bracket and the docker item, or the system bracket while Docker isn't
# running: 8 on both sides. The label is empty until claude.sh has the numbers, but always drawn:
# its padding is the room after the icon
claude=(
  "${icon_pill[@]}"
  "${claude_icon[@]}"
  padding_left=8
  padding_right=8
  update_freq=300
  script="$PLUGIN_DIR/claude.sh"
  "${popup[@]}"
  popup.align=right
  # No minimum: claude.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add event claude_update \
           --add item claude right \
           --set claude "${claude[@]}" \
           --subscribe claude claude_update system_woke mouse.clicked mouse.exited.global

# Docker: the whale with how many containers are running, in red when one is unhealthy or
# restarting, only while Docker answers. A click opens the engine and the running containers, each
# with its state, CPU, memory, image, ports and how long it has been up, and the row that opens
# Docker Desktop. docker.sh watch follows docker events and triggers docker_change when a container
# starts, stops, pauses or changes health, and when Docker starts or stops.
# The whale is the one of Docker Desktop, which helpers/docker_icons.js colors in its blue since
# SketchyBar can't color images, with the icons of the states in the colors of docker.sh; without
# Docker Desktop, e.g. with colima, it is a box
DOCKER_ICONS="$CONFIG_DIR/helpers/docker_icons"
DOCKER_APP=/Applications/Docker.app
if [ "$DOCKER_ICONS.js" -nt "$DOCKER_ICONS/circle.fill_green.png" ] \
   || [ "$DOCKER_APP/Contents/Resources/Assets.car" -nt "$DOCKER_ICONS/whale.png" ]; then
  osascript -l JavaScript "$DOCKER_ICONS.js" "$DOCKER_ICONS" "$DOCKER_APP" 2496ED \
            text=${TEXT#0xff} green=${GREEN#0xff} yellow=${YELLOW#0xff} red=${RED#0xff}
fi
# Between the claude item and the system bracket: 8 to the bracket, and the 8 of claude on its right
docker=(
  "${icon_pill[@]}"
  drawing=off
  padding_left=8
  padding_right=0
  script="$PLUGIN_DIR/docker.sh"
  "${popup[@]}"
  popup.align=right
  # No minimum: docker.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add event docker_change \
           --add item docker right \
           --set docker "${docker[@]}" \
           --subscribe docker docker_change system_woke mouse.clicked mouse.exited.global
pkill -f "$PLUGIN_DIR/docker.sh watch"
"$PLUGIN_DIR/docker.sh" watch > /dev/null 2>&1 &

# CPU, GPU and memory usage, read every 2 seconds. macOS has no command line tool for the GPU, and
# the CPU needs two readings to count the time it worked between them: a Swift helper (rebuilt
# when its source changes) reads all three and triggers system_stats_change when one changes, and
# system.sh, run by the ram item, the only one on every display (CPU and GPU aren't on the one with
# the notch, see notch.sh below), updates all three. The labels of CPU and GPU are as wide as
# "100%" (the digits of Helvetica Neue are all as wide), so the bar doesn't move when a number gains
# or loses a digit. The memory always has two, short of 100%: its label is as wide as its text, so
# that alone in its pill it is in the middle of it.
# The icons are the SF Symbols cpu, cube and memorychip.
# A click on any of them opens the popup of the bracket, under the three: for each the details and
# the apps that use it most, which the helper adds to its updates while the popup is open, and a
# row that opens Activity Monitor
STATS_HELPER="$CONFIG_DIR/helpers/system_stats"
if [ ! -x "$STATS_HELPER" ] || [ "$STATS_HELPER.swift" -nt "$STATS_HELPER" ]; then
  swiftc -O "$STATS_HELPER.swift" -o "$STATS_HELPER"
fi
system_stat=(
  "${with_icon[@]}"
  script="$PLUGIN_DIR/system.sh"
)
LABEL_100=43  # label.padding_left + 35 + label.padding_right
system=(
  "${pill[@]}"
  "${popup[@]}"
  # SketchyBar moves a popup aligned left by the padding_left of its item: the bracket's would take
  # it out of the pill
  padding_left=0
  popup.align=left
  # No minimum: system.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add event system_stats_change \
           --add item ram right \
           --set ram "${system_stat[@]}" icon=􀫦 \
           --subscribe ram system_stats_change mouse.clicked mouse.exited.global \
           --add item gpu right \
           --set gpu "${system_stat[@]}" icon=􀐘 label.width=$LABEL_100 \
           --subscribe gpu mouse.clicked \
           --add item cpu right \
           --set cpu "${system_stat[@]}" icon=􀫥 label.width=$LABEL_100 \
           --subscribe cpu mouse.clicked \
           --add bracket system cpu gpu ram \
           --set system "${system[@]}"
pkill -x system_stats
"$STATS_HELPER" watch > /dev/null 2>&1 &

# Home Assistant: its logo with how many devices of the popup are on, gray while the server can't be
# reached, and while the 3D printer prints its progress, in a pill of its own on the left. A click on either
# opens the popup: the devices of home_assistant.conf, each with its state, where a click turns it
# on or off (the plug of the printer at the second click), and a slider for the brightness, the
# position of the blinds or the temperature; the last row opens the dashboard. The server and the
# entities are those of the house, so home_assistant.conf isn't in the repo (see
# home_assistant.conf.example): without it the items stay hidden.
# A Swift helper (rebuilt when its source changes) follows them through the WebSocket API of Home
# Assistant and triggers home_assistant_change when one changes, and calls the services; home.sh
# starts it, with the server and the entities of home_assistant.conf. The token is in the keychain (see
# helpers/home_assistant.swift). The icons are SF Symbols, which helpers/home_assistant_icons.js
# draws into helpers/home_assistant_icons in each of these colors, and the logo, in the blue of Home
# Assistant (brand) and gray. The logo is a trademark, so it isn't in the repo: the server has it,
# as the icon of pinned tabs in Safari, and it is downloaded once into
# helpers/home_assistant_logo.svg; until then, e.g. with the server unreachable, home.sh shows a house
HA_HELPER="$CONFIG_DIR/helpers/home_assistant"
if [ ! -x "$HA_HELPER" ] || [ "$HA_HELPER.swift" -nt "$HA_HELPER" ]; then
  swiftc -O "$HA_HELPER.swift" -o "$HA_HELPER"
fi
HA_ICONS="$CONFIG_DIR/helpers/home_assistant_icons"
HA_LOGO="$CONFIG_DIR/helpers/home_assistant_logo.svg"
if [ ! -f "$HA_LOGO" ] && [ -f "$CONFIG_DIR/home_assistant.conf" ]; then
  HA_SERVER="$(source "$CONFIG_DIR/home_assistant.conf" && echo "$SERVER")"
  curl -sf --max-time 5 -o "$HA_LOGO.tmp" "$HA_SERVER/static/icons/mask-icon.svg" && mv "$HA_LOGO.tmp" "$HA_LOGO"
  rm -f "$HA_LOGO.tmp"
fi
if [ "$HA_ICONS.js" -nt "$HA_ICONS/house.fill_text.png" ] || [ "$HA_LOGO" -nt "$HA_ICONS/logo_brand.png" ]; then
  osascript -l JavaScript "$HA_ICONS.js" "$HA_ICONS" "$HA_LOGO" \
            text=${TEXT#0xff} subtext=${SUBTEXT#0xff} overlay=${OVERLAY#0xff} primary=${PRIMARY#0xff} \
            yellow=${YELLOW#0xff} peach=${PEACH#0xff} sky=${SKY#0xff} teal=${TEAL#0xff} \
            green=${GREEN#0xff} red=${RED#0xff} brand=18BCF2
fi
# padding_right=8: the system bracket is on its right
home=(
  "${icon_pill[@]}"
  padding_right=8
  script="$PLUGIN_DIR/home.sh"
  "${popup[@]}"
  popup.align=right
  # No minimum: home.sh gives each row of the popup its own height
  popup.height=0
)
sketchybar --add event home_assistant_change \
           --add item home right \
           --set home "${home[@]}" \
           --subscribe home home_assistant_change system_woke mouse.clicked mouse.exited.global \
           --add item home_printer right \
           --set home_printer "${icon_pill[@]}" drawing=off script="$PLUGIN_DIR/home.sh" \
           --subscribe home_printer mouse.clicked
pkill -x home_assistant
"$PLUGIN_DIR/home.sh" watch

##### Notch #####
# On a MacBook's display the notch covers the middle of the bar, and the items on the right would
# end up under it: notch.sh shows CPU, GPU, the names of the audio devices, of the Wi-Fi, of the VPN
# and of the event and the date only on the displays without one. There the memory stays alone, the
# audio devices, the connection and the VPN with only their icons, the event with only its time and
# the clock with only the hour. SketchyBar numbers the displays by their arrangement, which changes
# as displays come and go: display_change fires then, and whenever another display becomes the
# active one
sketchybar --add item notch left \
           --set notch drawing=off script="$PLUGIN_DIR/notch.sh" \
           --subscribe notch display_change

##### Force all scripts to run the first time #####
sketchybar --update
